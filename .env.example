# ==============================================================================
# CA Firm OS Enterprise Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL for Enterprise production / SQLite for local dev)
DATABASE_URL=sqlite:///./ca_platform.db
# DATABASE_URL=postgresql://ca_user:ca_password@localhost:5432/ca_platform

# Security & Cryptographic Tokens
SECRET_KEY=change-this-to-a-very-secure-random-256-bit-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment & Application
APP_NAME=CA Firm OS Enterprise Platform
DEBUG=false
ENVIRONMENT=production

# CORS Allowed Origins
CORS_ORIGINS=["https://firmosweb.vercel.app","http://localhost:8000","http://127.0.0.1:8000"]

# GSTN GSP API Gateway Credentials (Sandbox / Production)
GSP_ENV=sandbox
GSP_PRIMARY_URL=https://gsp.adaequare.com/api/v1
GSP_CLIENT_ID=your-gsp-client-id
GSP_CLIENT_SECRET=your-gsp-client-secret

# WhatsApp Business API for Client Chasing & OTP
WABA_API_URL=https://graph.facebook.com/v19.0/your-phone-number-id/messages
WABA_TOKEN=your-meta-access-token
