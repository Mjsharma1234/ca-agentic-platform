# Database Connection
DATABASE_URL=sqlite:///./ca_platform.db
# PostgreSQL (production): provision roles with db/provision_roles.sql, then
# DATABASE_URL=postgresql://ca_api:change-me-api@localhost:5432/ca_platform?sslmode=require
# DATABASE_ADMIN_URL=postgresql://ca_owner:change-me-owner@localhost:5432/ca_platform?sslmode=require   # alembic only
# DB_APP_ROLE=ca_app           # row-level-security role; required when DEBUG=false on PostgreSQL
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=30000

# Security
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a committed value; the app refuses known placeholders when DEBUG=false.
SECRET_KEY=GENERATE_A_RANDOM_VALUE_AT_LEAST_32_CHARS
# Local development. Production (DEBUG=false) additionally requires: a real SECRET_KEY,
# SHARED_STORE_URL, Firebase login, explicit CORS_ORIGINS, and DB_APP_ROLE on PostgreSQL.
DEBUG=true
APP_NAME=CA Firm OS Enterprise Platform
CORS_ORIGINS=["https://firmosweb.vercel.app","http://localhost:8000","http://127.0.0.1:8000"]

# Optional Redis shared by all workers for rate limits and Firebase token replay protection.
# Unset => per-process memory (limits multiply by the number of workers).
# SHARED_STORE_URL=redis://:password@host:6379/0

# Login: every login is a Firebase phone-OTP sign-in (required when DEBUG=false). The API verifies the ID token with
# Google's public keys; no service-account file is needed.
# LOGIN_PROVIDER=firebase
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_MAX_AUTH_AGE_SECONDS=300
# Public web-app identifiers served to the Firm OS web app by GET /auth/config (Project settings > Your apps > Web app)
# FIREBASE_WEB_API_KEY=AIza...
# FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com   # optional; this is the default
# BOOTSTRAP_ADMIN_PHONE=+919876543210   # first-ever login only: creates the firm's first Partner
