# Database Connection
DATABASE_URL=sqlite:///./ca_platform.db
# PostgreSQL (production): provision roles with db/provision_roles.sql, then
# DATABASE_URL=postgresql://ca_api:change-me-api@localhost:5432/ca_platform?sslmode=require
# DATABASE_ADMIN_URL=postgresql://ca_owner:change-me-owner@localhost:5432/ca_platform?sslmode=require   # alembic only
# DB_APP_ROLE=ca_app           # row-level-security role; required when DEBUG=false on PostgreSQL
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=30000

# Security
SECRET_KEY=enterprise-jwt-secret-key-change-in-production-2026
DEBUG=false
APP_NAME=CA Firm OS Enterprise Platform
CORS_ORIGINS=["https://firmosweb.vercel.app","http://localhost:8000","http://127.0.0.1:8000"]

# GST Suvidha Provider (GSP) Integration
GSP_BASE_URL=https://asp.adaequare.com/selfservice
GSP_CLIENT_ID=your_gsp_client_id_here
GSP_CLIENT_SECRET=your_gsp_client_secret_here
GSP_SIMULATION_MODE=true

# --- Desktop signer / DSC ---
# REQUIRED when DEBUG=false (the app refuses to start without them):
# DSC_TRUSTED_CA_PEM_PATH=/etc/ca/licensed-ca.pem   # certifying authority that issues your partners' DSCs ...
# DSC_TRUSTED_CA_PEM=                                # ... or the PEM itself (newlines may be written as 
)
# PUBLIC_WEB_URL=https://your-web-host              # https; shown to the signer as the approval page base
# PUBLIC_API_URL=https://your-api-host              # https; signer DPoP proofs are bound to it (no path)
# Revocation: OCSP first, then CRL. off is not allowed in production.
# DSC_REVOCATION_MODE=strict                         # soft | strict  (soft lets "status unknown" through)
# DSC_OCSP_ENABLED=true
# DSC_OCSP_CACHE_SECONDS=300
# DSC_CRL_CACHE_SECONDS=3600
# Signer tokens
# SIGNER_REQUIRE_DPOP=true                           # sender-constrained tokens (RFC 9449); keep true
# SIGNER_ACCESS_TOKEN_MINUTES=15
# SIGNER_REFRESH_DAYS=30
# Optional Redis shared by all workers for rate limits and DPoP replay protection.
# Unset => per-process memory (limits multiply by the number of workers).
# SHARED_STORE_URL=redis://:password@host:6379/0
